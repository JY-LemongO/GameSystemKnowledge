digraph G {
  graph [fontname="Noto Sans KR", bgcolor="#ffffff", margin=0.12, pad=0.25, ranksep=0.74, nodesep=0.58, newrank=true, compound=true, splines=polyline, label="Core Runtime 상세 03 · 원자 커밋과 반응", labelloc="t", labeljust="l", fontsize=20, fontcolor="#182033"];
  node [fontname="Noto Sans KR", shape=box, style="rounded,filled", color="#bac7db", penwidth=1.4, fillcolor="#ffffff", fontcolor="#182033", margin="0.14,0.09", width=2.05, height=0.55];
  edge [fontname="Noto Sans KR", color="#59687e", fontcolor="#46566e", arrowsize=0.8, penwidth=1.3];
  rankdir=LR;

  RuntimeCommitter [label="RuntimeCommitter\n상태 + outbox 원자 커밋", fillcolor="#eefbf6", color="#61b99a", penwidth=1.8];
  DurableOutbox [label="Durable Outbox\n커밋된 이벤트 레코드", fillcolor="#e9fbff", color="#54b7cf"];
  EventBus [label="EventBus\n커밋된 사실만 전달", fillcolor="#fff0f3", color="#e07b91"];
  ReactionQueue [label="ReactionQueue\n우선순위 · 안정 키\n깊이 · 예산 제한", fillcolor="#f3eefc", color="#ab8fe0"];
  Effect [label="Effect System\n새 Effect 명령 처리", fillcolor="#fff0f3", color="#e07b91"];
  Status [label="Status System\n새 ApplyStatus 명령 처리", fillcolor="#f3eefc", color="#ab8fe0"];

  { rank=same; Effect; Status; }
  Effect -> Status [style=invis, weight=50];

  RuntimeCommitter -> DurableOutbox [label="같은 트랜잭션"];
  DurableOutbox -> EventBus [label="커밋 사실 발행"];
  EventBus -> ReactionQueue [label="상태 변경 반응 예약"];
  ReactionQueue -> Effect [label="새 Effect 명령", style=dashed, color="#8d6cc7", fontcolor="#7251aa"];
  ReactionQueue -> Status [label="새 ApplyStatus 명령", style=dashed, color="#8d6cc7", fontcolor="#7251aa"];
}
