digraph G {
  graph [fontname="Noto Sans KR", bgcolor="#ffffff", margin=0.12, pad=0.28, ranksep=0.76, nodesep=0.60, outputorder=edgesfirst, splines=polyline, label="Effect 실행 상세 2 · 도메인 해석과 결정론적 합성", labelloc=t, fontsize=16];
  node [fontname="Noto Sans KR", shape=box, style="rounded,filled", color="#bac7db", penwidth=1.4, fillcolor="#ffffff", fontcolor="#182033", margin="0.16,0.10"];
  edge [fontname="Noto Sans KR", color="#59687e", fontcolor="#46566e", fontsize=9, arrowsize=0.8, penwidth=1.3];

  rankdir=TB;

  Resolved [label="ResolvedEffectOperation\n대상 결합이 끝난 입력", fillcolor="#eefbf6", color="#61b99a"];
  DomainResolver [label="<<owning domain / product adapter boundary>>\n순수 계산만 수행", fillcolor="#fff7e6", color="#e0ad4e", style="rounded,filled,dashed"];
  Outcome [label="EffectOperationOutcome\nApplied | NotApplicable | Rejected", fillcolor="#fff7e6", color="#e0ad4e"];
  Fragment [label="CommitPlanFragment\npreconditions + mutations\n+ outbox blueprint", fillcolor="#eaf0ff", color="#8292f7"];
  Composer [label="DeterministicEffectCommitPlanComposer\n안정 순서 + 충돌 거부", fillcolor="#eaf0ff", color="#8292f7"];
  Status [shape=diamond, label="Composition status?", fillcolor="#fff7e6", color="#e0ad4e"];
  CommitPlan [label="Ready\nCommitPlan", fillcolor="#e9fbff", color="#54b7cf"];
  NoChanges [label="NoChanges\n커밋 없음 · outbox 없음", fillcolor="#f0f3f9", color="#99a8bd"];
  Rejected [shape=note, label="Rejected\n충돌 또는 잘못된 fragment\n상태 변경 없음", fillcolor="#fff0f3", color="#e07b91"];

  { rank=same; CommitPlan; NoChanges; Rejected; }

  Resolved -> DomainResolver [label="도메인 소유자에게 전달"];
  DomainResolver -> Outcome [label="순수 계산 결과"];
  Outcome -> Fragment [label="Applied", color="#3D8B6D"];
  Fragment -> Composer [label="합성 후보"];
  Outcome -> Composer [label="NotApplicable / Rejected\nfragment 없음", color="#8292A8", constraint=false];
  Composer -> Status [label="결정론적 판정"];
  Status -> CommitPlan [label="Ready", color="#3D8B6D"];
  Status -> NoChanges [label="NoChanges", color="#8292A8"];
  Status -> Rejected [label="Rejected", style=dashed, color="#dc2626", fontcolor="#dc2626"];
}
