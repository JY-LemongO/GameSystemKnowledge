digraph G {
  graph [fontname="Noto Sans KR", bgcolor="#ffffff", margin=0.12, pad=0.25, ranksep=0.78, nodesep=0.72, newrank=true, splines=polyline, label="Skill Timeline 상세 2/3 · 선딜과 release 준비", labelloc=t, fontsize=18];
  node [fontname="Noto Sans KR", shape=box, style="rounded,filled", color="#bac7db", penwidth=1.4, fillcolor="#ffffff", fontcolor="#182033", margin="0.18,0.11", width=2.9, height=0.56];
  edge [fontname="Noto Sans KR", color="#59687e", fontcolor="#46566e", fontsize=10, arrowsize=0.8, penwidth=1.3];
  rankdir=TB;

  Execution [style="rounded,dashed,filled", label="<<internal project model · product-only>>\nSkillExecution\nwindup / cast 진행", fillcolor="#e9fbff", color="#54b7cf"];
  Interrupted [shape=diamond, style="filled,dashed", label="<<product-only timeline>>\nrelease 전에 중단됐는가?", fillcolor="#f3eefc", color="#ab8fe0"];
  Failure [style="rounded,dashed,filled", label="<<public SkillResult 목표 경계>>\n중단 실패 사유 반환\n예약 비용은 폐기", fillcolor="#fff0f3", color="#e07b91"];
  Compensation [shape=note, style="filled,dashed", label="<<product-only 선택 정책>>\n선결제였다면 명시적 보상 command\n현재 실행 C#에는 없음", fillcolor="#fff0f3", color="#e07b91"];
  Marker [style="rounded,dashed,filled", label="<<product-only timeline>>\nrelease marker 도달\n이 시점부터 실행 plan 준비", fillcolor="#fff7e6", color="#e0ad4e"];
  Context [label="<<public Effect contract>>\nEffectBundle + EffectContext\n대상 snapshot과 실행 맥락 전달", fillcolor="#eefbf6", color="#61b99a"];
  Planner [label="<<public Effect interface>>\nIEffectPlanner.Prepare\n상태를 바꾸지 않고 효과 plan 계산", fillcolor="#eaf0ff", color="#8292f7"];
  EffectPlan [label="<<public Effect contract>>\nEffectBundlePlan\nPrimaryOperations + Reactions", fillcolor="#eefbf6", color="#61b99a"];
  ReleasePlan [style="rounded,dashed,filled", label="<<internal project model · product-only>>\nSkillReleasePlan\n비용·쿨다운 mutation과 Effect plan 결합 대기", fillcolor="#e9fbff", color="#54b7cf"];

  { rank=same; Failure; Marker; }
  { rank=same; Compensation; Context; }

  Execution -> Interrupted [style=dashed];
  Interrupted -> Failure [label="예 · 중단", style=dashed, color="#c35f76", fontcolor="#9d4358"];
  Failure -> Compensation [label="선결제인 경우만", style=dashed];
  Interrupted -> Marker [label="아니오 · release", style=dashed, color="#4f8b74", fontcolor="#3f735f"];
  Marker -> Context [style=dashed];
  Context -> Planner -> EffectPlan -> ReleasePlan;
}
