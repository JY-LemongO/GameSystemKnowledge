digraph G {
  graph [fontname="Noto Sans KR", bgcolor="#ffffff", margin=0.12, pad=0.28, ranksep=0.82, nodesep=0.72, newrank=true, splines=polyline, label="Skill Data Model 상세 1/3 · 정적 정의 데이터 (product-only)", labelloc=t, fontsize=18];
  node [fontname="Noto Sans KR", shape=box, style="rounded,dashed,filled", color="#bac7db", penwidth=1.4, fillcolor="#ffffff", fontcolor="#182033", margin="0.18,0.11", width=2.65, height=0.58];
  edge [fontname="Noto Sans KR", color="#59687e", fontcolor="#46566e", fontsize=10, arrowsize=0.8, penwidth=1.3, style=dashed];
  rankdir=LR;

  SkillDef [label="<<product model>> SkillDefinition\nid · tags · 표시 정보\n현재 실행 C#의 구현 타입이 아님", fillcolor="#fff7e6", color="#e0ad4e"];
  CostDef [label="<<product model>> CostDefinition\nresource · amount · pay timing", fillcolor="#fff0f3", color="#e07b91"];
  CooldownDef [label="<<product model>> CooldownDefinition\nduration · group · charges", fillcolor="#fff0f3", color="#e07b91"];
  TargetDef [label="<<product model>> TargetingSpec\ntype · range · line of sight", fillcolor="#e9fbff", color="#54b7cf"];
  TimelineDef [label="<<product model>> TimelineDefinition\nphases · markers · cancel windows", fillcolor="#e9fbff", color="#54b7cf"];
  BundleRef [label="<<product model>> EffectBundleRef\npublic EffectBundle 계약을 참조\nprimary effects · reactions · policy", fillcolor="#fff7e6", color="#e0ad4e"];

  { rank=same; CostDef; CooldownDef; TargetDef; TimelineDef; BundleRef; }

  SkillDef -> CostDef [label="비용"];
  SkillDef -> CooldownDef [label="쿨다운"];
  SkillDef -> TargetDef [label="대상 규칙"];
  SkillDef -> TimelineDef [label="시간 구조"];
  SkillDef -> BundleRef [label="효과 참조"];
}
